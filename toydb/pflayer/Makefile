# PUBLICDIR = /usr0/cs564/public/project

CC = cc
LD = ld

# Compiler flags for legacy GNU89-compatible code
CFLAGS = -std=gnu89 -Wno-implicit-function-declaration

# Source files
SRC = buf.c hash.c pf.c

# Object files
OBJ = buf.o hash.o pf.o

# Header files
HDR = pftypes.h pf.h

# All test programs
TESTS = testhash testpf testbuf teststats testlru testexperiment testworkload

# Files generated by tests
TEST_FILES = file1 file2 testbuf_file teststats_file testlru_file testexperiment_file testworkload_file

.PHONY: all tests test run-tests clean lint

# Default target
all: pflayer.o

# Build the PF layer
pflayer.o: $(OBJ)
	$(LD) -r -o $@ $(OBJ)

# Header dependencies
$(OBJ) $(TESTS:%=%.o): $(HDR)

# Build all test programs
tests: $(TESTS)

# Existing PF test
testpf: testpf.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# Existing hash test
testhash: testhash.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# Buffer manager test
testbuf: testbuf.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# Buffer statistics test
teststats: teststats.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# Strict LRU test
testlru: testlru.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# PF buffer performance experiment
testexperiment: testexperiment.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# PF read/write workload experiment
testworkload: testworkload.o pflayer.o
	$(CC) $(CFLAGS) -o $@ $^

# Run all tests and PF experiments
test: tests
	rm -f $(TEST_FILES)
	./testhash
	./testpf
	./testbuf
	./teststats
	./testlru
	@echo "\n===== PF BUFFER EXPERIMENTS ====="
	@echo "Policy   Capacity   LogicalReads PhysicalReads  BufferHits   PhysicalWrites HitRatio"
	./testexperiment 2 0
	./testexperiment 4 0
	./testexperiment 8 0
	./testexperiment 16 0
	./testexperiment 2 1
	./testexperiment 4 1
	./testexperiment 8 1
	./testexperiment 16 1
	@echo "\n===== PF READ/WRITE WORKLOAD EXPERIMENTS ====="
	./testworkload
	rm -f $(TEST_FILES)

# Alias for running all tests
run-tests: test

# Remove generated files
clean:
	rm -f *.o pflayer.o $(TESTS) $(TEST_FILES)

# Run lint
lint:
	lint $(SRC)
